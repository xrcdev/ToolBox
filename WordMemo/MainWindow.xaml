<Window x:Class="WordMemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="英语单词备忘录"
        Height="640" Width="980"
        MinHeight="560" MinWidth="860"
        FontSize="13"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF0078D7"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#FF106EBE"/>
        <SolidColorBrush x:Key="AccentTintBrush" Color="#FFEAF3FC"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="#FFD0E4FC"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FFDADDE2"/>
        <SolidColorBrush x:Key="BorderStrongBrush" Color="#FFC4C9D2"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF24292F"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF57606A"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFF7F8FA"/>
        <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#FFF3F4F6"/>
        <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#FF9CA3AF"/>

        <!-- 圆角按钮 -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTintBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF8FBFEF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF6FA9E0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DisabledBackgroundBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFE1E3E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 圆角文本框 -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentLightBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFAEB4BE"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DisabledBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片式 GroupBox -->
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <DockPanel>
                                <Border DockPanel.Dock="Top"
                                        Background="{StaticResource CardBackgroundBrush}"
                                        BorderBrush="#FFE8EAED"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="7,7,0,0"
                                        Padding="12,7,12,7">
                                    <ContentPresenter ContentSource="Header"
                                                      TextElement.FontWeight="SemiBold"
                                                      TextElement.Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Border>
                                <ContentPresenter Margin="12"/>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分段式选项卡（前景色只作用于头部，避免继承进内容区） -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel KeyboardNavigation.TabNavigation="Local">
                            <TabPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="0,0,0,8" Panel.ZIndex="1"/>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <!-- UIA 通过该部件名暴露选中内容，缺失会导致自动化树里看不到内容区 -->
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                CornerRadius="6"
                                Background="Transparent"
                                Padding="18,8"
                                Margin="0,0,6,0">
                            <ContentPresenter x:Name="HeaderPresenter"
                                              ContentSource="Header"
                                              TextElement.Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="White"/>
                                <Setter TargetName="HeaderPresenter" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTintBrush}"/>
                                <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 扁平 DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FFFAFBFD"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FFEFF1F4"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="#FFF6F7F9"
                                BorderBrush="#FFE4E6EA"
                                BorderThickness="0,0,1,1"
                                Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 细圆角进度条 -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#FFEDEFF3"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track"
                                    CornerRadius="5"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"/>
                            <Border x:Name="PART_Indicator"
                                    CornerRadius="4"
                                    Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left"
                                    Margin="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatsTextBlock" Text="就绪"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="DataFileTextBlock" ToolTip="数据文件位置"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12">
            <TabControl>
                <!-- ==================== 单词本 ==================== -->
                <TabItem Header="单词本">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="搜索："/>
                                <TextBox x:Name="SearchBox" Width="240" Margin="6,0,0,0"
                                         VerticalContentAlignment="Center"
                                         TextChanged="SearchBox_TextChanged"
                                         ToolTip="按单词 / 释义 / 分类实时过滤"/>
                                <Button Margin="12,0,0,0" Click="AddButton_Click" Content="新增单词"/>
                                <Button Margin="8,0,0,0" Click="DeleteButton_Click" Content="删除选中"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Click="ImportButton_Click" Content="导入 CSV"/>
                                <Button Margin="8,0,0,0" Click="ExportButton_Click" Content="导出 CSV"/>
                            </StackPanel>
                        </DockPanel>

                        <DataGrid x:Name="WordsGrid"
                                  Grid.Row="1"
                                  Margin="0,10,0,0"
                                  SelectionChanged="WordsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Word}" Header="单词" Width="150"/>
                                <DataGridTextColumn Binding="{Binding Meaning}" Header="释义" Width="*"/>
                                <DataGridTextColumn Binding="{Binding Category}" Header="分类" Width="90"/>
                                <DataGridTextColumn Binding="{Binding ProficiencyDisplay}" Header="熟练度" Width="100"/>
                                <DataGridTextColumn Binding="{Binding AddedDate, StringFormat=yyyy-MM-dd}" Header="添加时间" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <GroupBox Grid.Row="2" Margin="0,10,0,0" Header="编辑单词">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock VerticalAlignment="Center" Text="单词："/>
                                <TextBox x:Name="WordInput" Grid.Column="1" Margin="0,0,16,8" VerticalContentAlignment="Center"/>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="音标："/>
                                <TextBox x:Name="PhoneticsInput" Grid.Column="3" Margin="0,0,16,8" VerticalContentAlignment="Center"/>
                                <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="分类："/>
                                <TextBox x:Name="CategoryInput" Grid.Column="5" Margin="0,0,0,8" VerticalContentAlignment="Center"
                                         ToolTip="如：四级 / 考研 / 日常"/>

                                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="释义："/>
                                <TextBox x:Name="MeaningInput" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Margin="0,0,0,8" VerticalContentAlignment="Center"/>

                                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="例句："/>
                                <TextBox x:Name="ExampleInput" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" Margin="0,0,0,8" VerticalContentAlignment="Center"/>

                                <TextBlock Grid.Row="3" VerticalAlignment="Top" Margin="0,5,0,0" Text="备注："/>
                                <TextBox x:Name="NoteInput" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="5" Height="54"
                                         Margin="0,0,0,8" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"/>

                                <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="选中列表行可编辑；单词重复时保存即更新该行。"/>
                                <Button x:Name="SaveButton" Grid.Row="4" Grid.Column="5" Click="SaveButton_Click" Content="保存修改"/>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <!-- ==================== 复习 ==================== -->
                <TabItem Header="复习">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="范围："/>
                            <ComboBox x:Name="CategoryFilter" Width="160" Height="30" Margin="6,0,0,0"/>
                            <Button x:Name="StartQuizButton" Margin="12,0,0,0" Click="StartQuizButton_Click" Content="开始复习"/>
                            <Button x:Name="StopQuizButton" Margin="8,0,0,0" Click="StopQuizButton_Click" Content="结束复习" IsEnabled="False"/>
                            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="每轮最多 20 个，掌握最差、最久未复习的优先出现。"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <TextBlock x:Name="QuizProgressText" Text="尚未开始"/>
                            <ProgressBar x:Name="QuizProgress" Height="10" Margin="0,6,0,0" Maximum="20"/>
                        </StackPanel>

                        <Border Grid.Row="2"
                                Margin="0,10,0,0"
                                Padding="24"
                                Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="QuizWordText"
                                           FontSize="32"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Text="点击「开始复习」"/>
                                <TextBlock x:Name="QuizPhoneticsText"
                                           Margin="0,6,0,0"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="QuizMeaningText"
                                           Margin="0,18,0,0"
                                           FontSize="17"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="QuizExampleText"
                                           Margin="0,12,0,0"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="QuizNoteText"
                                           Margin="0,6,0,0"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="3" Margin="0,10,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                            <Button x:Name="ShowMeaningButton" Width="130" Click="ShowMeaningButton_Click" Content="显示释义" IsEnabled="False"/>
                            <Button x:Name="RecognizeButton" Width="100" Margin="12,0,0,0" Click="RecognizeButton_Click" Content="认识" IsEnabled="False"/>
                            <Button x:Name="FuzzyButton" Width="100" Margin="8,0,0,0" Click="FuzzyButton_Click" Content="模糊" IsEnabled="False"/>
                            <Button x:Name="ForgetButton" Width="100" Margin="8,0,0,0" Click="ForgetButton_Click" Content="忘记" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
