<Window x:Class="RemoveFileReadonlyAttribute.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="文件只读属性移除工具" Height="560" Width="780" MinHeight="460" MinWidth="660">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="目标文件夹">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderPathTextBox"
                         VerticalContentAlignment="Center"
                         ToolTip="也可以直接粘贴文件夹路径" />
                <Button x:Name="BrowseButton"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        Padding="16,4"
                        Click="BrowseButton_Click"
                        Content="浏览..." />
            </Grid>
        </GroupBox>

        <GroupBox x:Name="OptionsGroupBox" Grid.Row="1" Margin="0,12,0,0" Header="处理选项">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="忽略的文件夹（每行一个，按文件夹名或相对路径匹配）" />
                        <TextBox x:Name="IgnoredFoldersTextBox"
                                 Height="96"
                                 Margin="0,6,0,0"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 ToolTip="例如：node_modules&#x0a;或按相对路径：src\test"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="忽略的扩展名（每行一个，如 .exe）" />
                        <TextBox x:Name="IgnoredExtensionsTextBox"
                                 Height="96"
                                 Margin="0,6,0,0"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 ToolTip="例如：.exe&#x0a;.dll"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal">
                    <CheckBox x:Name="IncludeSubdirectoriesCheckBox"
                              VerticalAlignment="Center"
                              Content="包含子文件夹"
                              IsChecked="True"
                              ToolTip="关闭后只处理目标文件夹根目录下的文件" />
                    <CheckBox x:Name="ProcessDirectoriesCheckBox"
                              Margin="24,0,0,0"
                              VerticalAlignment="Center"
                              Content="同时移除文件夹的只读属性"
                              ToolTip="包含被忽略的文件夹本身" />
                    <CheckBox x:Name="OnlyLogChangesCheckBox"
                              Margin="24,0,0,0"
                              VerticalAlignment="Center"
                              Content="日志中仅显示发生修改或出错的项"
                              IsChecked="True" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Margin="0,12,0,0" Header="处理日志">
            <ListBox x:Name="LogListBox" FontFamily="Consolas" />
        </GroupBox>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="StatsTextBlock" VerticalAlignment="Center" Text="就绪" TextTrimming="CharacterEllipsis" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="StartButton"
                        Padding="20,4"
                        Click="StartButton_Click"
                        Content="开始处理" />
                <Button x:Name="StopButton"
                        Margin="12,0,0,0"
                        Padding="20,4"
                        Click="StopButton_Click"
                        Content="停止"
                        IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
