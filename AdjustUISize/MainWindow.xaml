<Window x:Class="AdjustUISize.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdjustUISize"
        mc:Ignorable="d"
        Title="Adjust UI Size" Height="520" Width="860"
        MinHeight="460" MinWidth="760">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="12"
                Background="#FFF7F7F7"
                BorderBrush="#FFD8D8D8"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="窗口尺寸快捷调整" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                    启动后会自动注册全局快捷键 <Run FontWeight="Bold" Text="Ctrl + Shift + 2" />。
                    先在下方选择一个尺寸预设，再切换到目标应用，按快捷键即可调整当前活动窗口大小。
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="尺寸预设列表">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="PresetsDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              ItemsSource="{Binding Presets}"
                              SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Name}" Header="名称" Width="*" />
                            <DataGridTextColumn Binding="{Binding Width}" Header="宽度" Width="100" />
                            <DataGridTextColumn Binding="{Binding Height}" Header="高度" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal">
                        <Button Width="100" Click="ApplySelectedPreset_Click" Content="应用到当前窗口" />
                        <Button Width="80" Margin="8,0,0,0" Click="RemovePreset_Click" Content="删除预设" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="编辑预设">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center" Text="名称" />
                    <TextBox x:Name="NameTextBox" Grid.Column="1" Margin="8,0,0,0" />

                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="宽度" />
                    <TextBox x:Name="WidthTextBox" Grid.Row="1" Grid.Column="1" Margin="8,8,0,0" />

                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="高度" />
                    <TextBox x:Name="HeightTextBox" Grid.Row="2" Grid.Column="1" Margin="8,8,0,0" />

                    <WrapPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,16,0,0">
                        <Button Width="100" Click="AddPreset_Click" Content="新增预设" />
                        <Button Width="100" Margin="8,0,0,0" Click="UpdatePreset_Click" Content="更新预设" />
                        <Button Width="80" Margin="8,0,0,0" Click="ClearEditor_Click" Content="清空" />
                    </WrapPanel>

                    <Border Grid.Row="4"
                            Grid.ColumnSpan="2"
                            Margin="0,16,0,0"
                            Padding="12"
                            Background="#FFF7F7F7"
                            BorderBrush="#FFD8D8D8"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="建议预设" />
                            <TextBlock Margin="0,8,0,0" Text="• 小窗办公：1280 × 720" />
                            <TextBlock Margin="0,4,0,0" Text="• 文档阅读：1440 × 900" />
                            <TextBlock Margin="0,4,0,0" Text="• 全高清：1600 × 900 / 1920 × 1080" />
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                                说明：快捷键会对“当前活动窗口”生效，因此建议先切换到目标程序，再按快捷键。
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="就绪" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
