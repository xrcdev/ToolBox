<Window x:Class="ToolBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ToolBox 工具箱"
        Height="700" Width="1040"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="NavItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="14,11">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFD0E4FC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE6EEF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧纵向导航条 -->
        <Border Grid.Column="0"
                Background="#FFF3F4F6"
                BorderBrush="#FFD8D8D8"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="18,18,16,14"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="🧰 ToolBox"/>
                <ListBox x:Name="NavList"
                         Background="Transparent"
                         BorderThickness="0"
                         AllowDrop="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource NavItemContainerStyle}"
                         PreviewMouseLeftButtonDown="NavList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="NavList_PreviewMouseMove"
                         DragOver="NavList_DragOver"
                         Drop="NavList_Drop"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="16" Text="{Binding Icon}" VerticalAlignment="Center"/>
                                <TextBlock FontSize="14"
                                           Margin="10,0,0,0"
                                           Text="{Binding Title}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右侧内容区 + 底部热键提示条 -->
        <DockPanel Grid.Column="1" Margin="0,4,0,0">
            <Border DockPanel.Dock="Bottom"
                    Background="#FFF7F7F7"
                    BorderBrush="#FFD8D8D8"
                    BorderThickness="0,1,0,0"
                    Padding="14,7">
                <TextBlock x:Name="HotkeyHintTextBlock"
                           FontSize="12"
                           Foreground="#FF555555"
                           TextWrapping="Wrap"
                           Text="就绪"/>
            </Border>
            <ContentControl x:Name="PageHost"/>
        </DockPanel>
    </Grid>
</Window>
