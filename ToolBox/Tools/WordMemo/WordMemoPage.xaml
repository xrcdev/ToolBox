<UserControl x:Class="ToolBox.Tools.WordMemo.WordMemoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="860">
    <!-- 移植自 WordMemo.MainWindow（.NET FW 4.6.2 老项目）：
         窗口级样式由外壳 Theme.xaml 提供，原底部 StatusBar 改为页内状态行 -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- ==================== 单词本 ==================== -->
            <TabItem Header="单词本">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="搜索："/>
                            <TextBox x:Name="SearchBox" Width="240" Margin="6,0,0,0"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"
                                     ToolTip="按单词 / 释义 / 分类实时过滤"/>
                            <Button Margin="12,0,0,0" Click="AddButton_Click" Content="新增单词"/>
                            <Button Margin="8,0,0,0" Click="DeleteButton_Click" Content="删除选中"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Click="ImportButton_Click" Content="导入 CSV"/>
                            <Button Margin="8,0,0,0" Click="ExportButton_Click" Content="导出 CSV"/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid x:Name="WordsGrid"
                              Grid.Row="1"
                              Margin="0,10,0,0"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionChanged="WordsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Word}" Header="单词" Width="150"/>
                            <DataGridTextColumn Binding="{Binding Meaning}" Header="释义" Width="*"/>
                            <DataGridTextColumn Binding="{Binding Category}" Header="分类" Width="90"/>
                            <DataGridTextColumn Binding="{Binding ProficiencyDisplay}" Header="熟练度" Width="100"/>
                            <DataGridTextColumn Binding="{Binding AddedDate, StringFormat=yyyy-MM-dd}" Header="添加时间" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GroupBox Grid.Row="2" Margin="0,10,0,0" Header="编辑单词">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock VerticalAlignment="Center" Text="单词："/>
                            <TextBox x:Name="WordInput" Grid.Column="1" Margin="0,0,16,8" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="音标："/>
                            <TextBox x:Name="PhoneticsInput" Grid.Column="3" Margin="0,0,16,8" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="分类："/>
                            <TextBox x:Name="CategoryInput" Grid.Column="5" Margin="0,0,0,8" VerticalContentAlignment="Center"
                                     ToolTip="如：四级 / 考研 / 日常"/>

                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="释义："/>
                            <TextBox x:Name="MeaningInput" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Margin="0,0,0,8" VerticalContentAlignment="Center"/>

                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="例句："/>
                            <TextBox x:Name="ExampleInput" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" Margin="0,0,0,8" VerticalContentAlignment="Center"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" Margin="0,5,0,0" Text="备注："/>
                            <TextBox x:Name="NoteInput" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="5" Height="54"
                                     Margin="0,0,0,8" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>

                            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="选中列表行可编辑；单词重复时保存即更新该行。"/>
                            <Button x:Name="SaveButton" Grid.Row="4" Grid.Column="5" Click="SaveButton_Click" Content="保存修改"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ==================== 复习 ==================== -->
            <TabItem Header="复习">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="范围："/>
                        <ComboBox x:Name="CategoryFilter" Width="160" Height="30" Margin="6,0,0,0"/>
                        <Button x:Name="StartQuizButton" Margin="12,0,0,0" Click="StartQuizButton_Click" Content="开始复习"/>
                        <Button x:Name="StopQuizButton" Margin="8,0,0,0" Click="StopQuizButton_Click" Content="结束复习" IsEnabled="False"/>
                        <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="每轮最多 20 个，掌握最差、最久未复习的优先出现。"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock x:Name="QuizProgressText" Text="尚未开始"/>
                        <ProgressBar x:Name="QuizProgress" Height="10" Margin="0,6,0,0" Maximum="20"/>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Margin="0,10,0,0"
                            Padding="24"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="QuizWordText"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Text="点击「开始复习」"/>
                            <TextBlock x:Name="QuizPhoneticsText"
                                       Margin="0,6,0,0"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="QuizMeaningText"
                                       Margin="0,18,0,0"
                                       FontSize="17"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="QuizExampleText"
                                       Margin="0,12,0,0"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="QuizNoteText"
                                       Margin="0,6,0,0"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="0,10,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button x:Name="ShowMeaningButton" Width="130" Click="ShowMeaningButton_Click" Content="显示释义" IsEnabled="False"/>
                        <Button x:Name="RecognizeButton" Width="100" Margin="12,0,0,0" Click="RecognizeButton_Click" Content="认识" IsEnabled="False"/>
                        <Button x:Name="FuzzyButton" Width="100" Margin="8,0,0,0" Click="FuzzyButton_Click" Content="模糊" IsEnabled="False"/>
                        <Button x:Name="ForgetButton" Width="100" Margin="8,0,0,0" Click="ForgetButton_Click" Content="忘记" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatsTextBlock"
                   Grid.Row="1"
                   Margin="2,8,2,0"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="就绪"/>
    </Grid>
</UserControl>
