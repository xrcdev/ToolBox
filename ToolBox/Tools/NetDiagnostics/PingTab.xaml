<UserControl x:Class="ToolBox.Tools.NetDiagnostics.PingTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="880">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="目标：" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtTargets" Grid.Column="1" VerticalContentAlignment="Center"
                     ToolTip="域名或 IP，多个目标用分号、逗号或空格分隔"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="次数：" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtCount" Width="56" VerticalContentAlignment="Center" Text="4"
                     ToolTip="每个目标的探测次数，0 表示连续 Ping 直到手动停止"/>
            <TextBlock Text="超时(ms)：" VerticalAlignment="Center" Margin="14,0,0,0"/>
            <TextBox x:Name="TxtTimeout" Width="64" VerticalContentAlignment="Center" Text="2000"/>
            <TextBlock Text="间隔(ms)：" VerticalAlignment="Center" Margin="14,0,0,0"/>
            <TextBox x:Name="TxtInterval" Width="64" VerticalContentAlignment="Center" Text="1000"/>
            <Button x:Name="BtnStart" Content="开始" Margin="20,0,0,0" MinWidth="72" Click="BtnStart_Click"/>
            <Button x:Name="BtnStop" Content="停止" Margin="8,0,0,0" MinWidth="72" IsEnabled="False" Click="BtnStop_Click"/>
        </StackPanel>

        <TextBlock x:Name="TxtStatus" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"/>

        <DataGrid x:Name="SummaryGrid" Grid.Row="3" Height="112" Margin="0,8,0,0"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Target}" Header="目标" Width="170"/>
                <DataGridTextColumn Binding="{Binding Ip}" Header="解析 IP" Width="130"/>
                <DataGridTextColumn Binding="{Binding Sent}" Header="已发送" Width="60"/>
                <DataGridTextColumn Binding="{Binding Received}" Header="已接收" Width="60"/>
                <DataGridTextColumn Binding="{Binding LossDisplay}" Header="丢包率" Width="60"/>
                <DataGridTextColumn Binding="{Binding MinDisplay}" Header="最小(ms)" Width="70"/>
                <DataGridTextColumn Binding="{Binding AvgDisplay}" Header="平均(ms)" Width="70"/>
                <DataGridTextColumn Binding="{Binding MaxDisplay}" Header="最大(ms)" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <DataGrid x:Name="ResultGrid" Grid.Row="4" Margin="0,8,0,0"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Target}" Header="目标" Width="150"/>
                <DataGridTextColumn Binding="{Binding Ip}" Header="回复 IP" Width="130"/>
                <DataGridTextColumn Binding="{Binding Seq}" Header="序号" Width="50"/>
                <DataGridTextColumn Binding="{Binding Status}" Header="状态" Width="*"/>
                <DataGridTextColumn Binding="{Binding RttDisplay}" Header="耗时(ms)" Width="80"/>
                <DataGridTextColumn Binding="{Binding Time}" Header="时间" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
