<UserControl x:Class="ToolBox.Tools.NetDiagnostics.TraceRouteTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="880">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="目标：" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtTarget" Width="260" VerticalContentAlignment="Center"
                     ToolTip="域名或 IP"/>
            <TextBlock Text="最大跃点：" VerticalAlignment="Center" Margin="14,0,0,0"/>
            <TextBox x:Name="TxtMaxHops" Width="48" VerticalContentAlignment="Center" Text="30"/>
            <TextBlock Text="探测次数：" VerticalAlignment="Center" Margin="14,0,0,0"/>
            <TextBox x:Name="TxtProbes" Width="48" VerticalContentAlignment="Center" Text="3"
                     ToolTip="每跳发送的探测包数量"/>
            <TextBlock Text="超时(ms)：" VerticalAlignment="Center" Margin="14,0,0,0"/>
            <TextBox x:Name="TxtTimeout" Width="64" VerticalContentAlignment="Center" Text="1500"/>
            <Button x:Name="BtnStart" Content="开始" Margin="20,0,0,0" MinWidth="72" Click="BtnStart_Click"/>
            <Button x:Name="BtnStop" Content="取消" Margin="8,0,0,0" MinWidth="72" IsEnabled="False" Click="BtnStop_Click"/>
        </StackPanel>

        <TextBlock x:Name="TxtStatus" Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"/>

        <DataGrid x:Name="ResultGrid" Grid.Row="2" Margin="0,8,0,0"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Hop}" Header="跃点" Width="50"/>
                <DataGridTextColumn Binding="{Binding Host}" Header="主机名" Width="210"/>
                <DataGridTextColumn Binding="{Binding Ip}" Header="IP" Width="140"/>
                <DataGridTextColumn Binding="{Binding ProbeDisplay}" Header="探测结果" Width="*"/>
                <DataGridTextColumn Binding="{Binding AvgDisplay}" Header="平均(ms)" Width="80"/>
                <DataGridTextColumn Binding="{Binding Note}" Header="备注" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
