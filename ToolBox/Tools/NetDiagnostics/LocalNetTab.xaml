<UserControl x:Class="ToolBox.Tools.NetDiagnostics.LocalNetTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="880">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="网卡信息">
            <DockPanel Margin="10">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Button Content="刷新" MinWidth="72" Click="BtnRefreshAdapters_Click"/>
                    <TextBlock x:Name="TxtAdapterCount" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <DataGrid x:Name="AdapterGrid" Height="168" Margin="0,8,0,0"
                          IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Name}" Header="名称" Width="150"/>
                        <DataGridTextColumn Binding="{Binding Type}" Header="类型" Width="80"/>
                        <DataGridTextColumn Binding="{Binding Status}" Header="状态" Width="70"/>
                        <DataGridTextColumn Binding="{Binding Ipv4}" Header="IPv4" Width="130"/>
                        <DataGridTextColumn Binding="{Binding Ipv6}" Header="IPv6" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Gateway}" Header="网关" Width="120"/>
                        <DataGridTextColumn Binding="{Binding Dns}" Header="DNS" Width="130"/>
                        <DataGridTextColumn Binding="{Binding Mac}" Header="MAC" Width="120"/>
                        <DataGridTextColumn Binding="{Binding Sent}" Header="已发送" Width="85"/>
                        <DataGridTextColumn Binding="{Binding Received}" Header="已接收" Width="85"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="活动连接" Margin="0,10,0,0">
            <DockPanel Margin="10">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <TextBlock Text="协议：" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CbProto" Width="86" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="全部"/>
                        <ComboBoxItem Content="TCP"/>
                        <ComboBoxItem Content="UDP"/>
                    </ComboBox>
                    <TextBlock Text="状态：" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CbState" Width="96" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="全部"/>
                        <ComboBoxItem Content="监听"/>
                        <ComboBoxItem Content="已建立"/>
                    </ComboBox>
                    <TextBlock Text="过滤：" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtFilter" Width="220" VerticalContentAlignment="Center" TextChanged="Filter_Changed"
                             ToolTip="按本地/远程地址、进程名或 PID 实时过滤"/>
                    <Button Content="刷新" Margin="14,0,0,0" MinWidth="72" Click="BtnRefreshConnections_Click"/>
                    <CheckBox x:Name="ChkAuto" Content="自动刷新(2s)" Margin="14,0,0,0" VerticalAlignment="Center"
                              Checked="ChkAuto_Checked" Unchecked="ChkAuto_Unchecked"/>
                    <TextBlock x:Name="TxtConnCount" Margin="14,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <DataGrid x:Name="ConnGrid" Margin="0,8,0,0"
                          IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Protocol}" Header="协议" Width="56"/>
                        <DataGridTextColumn Binding="{Binding Local}" Header="本地地址" Width="210"/>
                        <DataGridTextColumn Binding="{Binding Remote}" Header="远程地址" Width="210"/>
                        <DataGridTextColumn Binding="{Binding State}" Header="状态" Width="100"/>
                        <DataGridTextColumn Binding="{Binding Pid}" Header="PID" Width="70"/>
                        <DataGridTextColumn Binding="{Binding ProcessName}" Header="进程名" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>
    </Grid>
</UserControl>
