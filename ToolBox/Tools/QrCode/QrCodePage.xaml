<UserControl x:Class="ToolBox.Tools.QrCode.QrCodePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="640">
    <!-- 移植自 QrCodeGen 控制台工具（QRCoder 1.6）：文本+纠错级别+模块大小 → PNG 预览/导出；
         PngByteQRCode 不依赖 System.Drawing，WPF 下无类型歧义 -->
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="二维码内容:"/>
            <TextBox x:Name="TxtContent" Height="110" Margin="0,6,0,0" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="纠错级别:" VerticalAlignment="Center" ToolTip="L=7% M=15% Q=25% H=30% 可修复"/>
                <ComboBox x:Name="CbEccLevel" Width="70" Margin="6,0,0,0" SelectedIndex="1">
                    <ComboBoxItem Content="L"/>
                    <ComboBoxItem Content="M"/>
                    <ComboBoxItem Content="Q"/>
                    <ComboBoxItem Content="H"/>
                </ComboBox>
                <TextBlock Text="模块大小:" Margin="16,0,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtModuleSize" Width="50" Margin="6,0,0,0" Text="8"/>
                <Button x:Name="BtnGenerate" Content="生成二维码" Width="100" Height="30"
                        Margin="16,0,0,0" Click="BtnGenerate_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="BtnSavePng" Content="保存 PNG..." Width="110" Height="30"
                        IsEnabled="False" Click="BtnSavePng_Click"/>
            </StackPanel>
            <TextBlock x:Name="TxtStatus" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" Text="输入内容后点「生成二维码」。"/>
        </StackPanel>

        <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="10">
            <Image x:Name="ImgQr" Stretch="Uniform" StretchDirection="DownOnly"/>
        </Border>
    </Grid>
</UserControl>
