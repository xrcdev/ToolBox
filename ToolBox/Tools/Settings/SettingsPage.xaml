<UserControl x:Class="ToolBox.Tools.Settings.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="860">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="12" Background="#FFF7F7F7" BorderBrush="#FFD8D8D8" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="系统设置" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                    在此统一设置各功能的系统级快捷键：勾选修饰键、填写按键（支持单个字母、数字、F1-F24 等），
                    点击 <Run FontWeight="Bold" Text="应用快捷键" /> 后立即生效并保存，下次启动自动沿用。
                </TextBlock>
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="1" Margin="0,16,0,0" Header="全局快捷键">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 划词翻译 -->
                <TextBlock VerticalAlignment="Center" Text="划词翻译" />
                <CheckBox x:Name="TranslatorCtrlCheckBox" Grid.Column="1" VerticalAlignment="Center" Content="Ctrl" />
                <CheckBox x:Name="TranslatorShiftCheckBox" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Content="Shift" />
                <CheckBox x:Name="TranslatorAltCheckBox" Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" Content="Alt" />
                <CheckBox x:Name="TranslatorWinCheckBox" Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center" Content="Win" />
                <TextBlock Grid.Column="5" Margin="20,0,8,0" VerticalAlignment="Center" Text="按键" />
                <TextBox x:Name="TranslatorKeyTextBox" Grid.Column="6" VerticalContentAlignment="Center" Text="1" />
                <Button Grid.Column="7" Margin="12,0,0,0" Padding="16,4" Click="ApplyTranslator_Click" Content="应用快捷键" />

                <!-- 调整窗口大小 -->
                <TextBlock Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Center" Text="调整窗口大小" />
                <CheckBox x:Name="ResizeCtrlCheckBox" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" VerticalAlignment="Center" Content="Ctrl" />
                <CheckBox x:Name="ResizeShiftCheckBox" Grid.Row="1" Grid.Column="2" Margin="12,12,0,0" VerticalAlignment="Center" Content="Shift" />
                <CheckBox x:Name="ResizeAltCheckBox" Grid.Row="1" Grid.Column="3" Margin="12,12,0,0" VerticalAlignment="Center" Content="Alt" />
                <CheckBox x:Name="ResizeWinCheckBox" Grid.Row="1" Grid.Column="4" Margin="12,12,0,0" VerticalAlignment="Center" Content="Win" />
                <TextBlock Grid.Row="1" Grid.Column="5" Margin="20,12,8,0" VerticalAlignment="Center" Text="按键" />
                <TextBox x:Name="ResizeKeyTextBox" Grid.Row="1" Grid.Column="6" Margin="0,12,0,0" VerticalContentAlignment="Center" Text="2" />
                <Button Grid.Row="1" Grid.Column="7" Margin="12,12,0,0" Padding="16,4" Click="ApplyResize_Click" Content="应用快捷键" />

                <!-- 窗口置顶 -->
                <TextBlock Grid.Row="2" Margin="0,12,0,0" VerticalAlignment="Center" Text="窗口置顶" />
                <CheckBox x:Name="TopMostCtrlCheckBox" Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" VerticalAlignment="Center" Content="Ctrl" />
                <CheckBox x:Name="TopMostShiftCheckBox" Grid.Row="2" Grid.Column="2" Margin="12,12,0,0" VerticalAlignment="Center" Content="Shift" />
                <CheckBox x:Name="TopMostAltCheckBox" Grid.Row="2" Grid.Column="3" Margin="12,12,0,0" VerticalAlignment="Center" Content="Alt" />
                <CheckBox x:Name="TopMostWinCheckBox" Grid.Row="2" Grid.Column="4" Margin="12,12,0,0" VerticalAlignment="Center" Content="Win" />
                <TextBlock Grid.Row="2" Grid.Column="5" Margin="20,12,8,0" VerticalAlignment="Center" Text="按键" />
                <TextBox x:Name="TopMostKeyTextBox" Grid.Row="2" Grid.Column="6" Margin="0,12,0,0" VerticalContentAlignment="Center" Text="3" />
                <Button Grid.Row="2" Grid.Column="7" Margin="12,12,0,0" Padding="16,4" Click="ApplyTopMost_Click" Content="应用快捷键" />
            </Grid>
        </GroupBox>

        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <Button Content="恢复默认" Click="ResetDefaults_Click" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="就绪" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
