<UserControl x:Class="ToolBox.Tools.BatchRename.BatchRenamePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="680">
    <!-- 批量重命名：替换文本 / 加序号 / 加日期三种模式；执行前先出预览（旧名→新名→状态），
         冲突（目标已存在、批内重名、新名为空）的行标记后跳过 -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="添加文件..." Click="BtnAddFiles_Click"/>
            <Button Content="添加文件夹..." Margin="8,0,0,0" Click="BtnAddFolder_Click"/>
            <Button Content="移除选中" Margin="8,0,0,0" Click="BtnRemoveSelected_Click"/>
            <Button Content="清空" Margin="8,0,0,0" Click="BtnClear_Click"/>
        </StackPanel>

        <ListBox x:Name="FilesList" Grid.Row="1" Margin="0,10,0,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RbReplace" Content="替换文本" IsChecked="True" GroupName="RenameMode" Checked="Mode_Changed"/>
                <RadioButton x:Name="RbSequence" Content="加序号" GroupName="RenameMode" Margin="20,0,0,0" Checked="Mode_Changed"/>
                <RadioButton x:Name="RbDate" Content="加日期" GroupName="RenameMode" Margin="20,0,0,0" Checked="Mode_Changed"/>
            </StackPanel>

            <StackPanel x:Name="PnlReplace" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="查找:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtFind" Width="150" Margin="6,0,0,0" TextChanged="Setting_Changed"/>
                <TextBlock Text="替换为:" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtReplace" Width="150" Margin="6,0,0,0" TextChanged="Setting_Changed"/>
                <CheckBox x:Name="CbIgnoreCase" Content="忽略大小写" Margin="12,0,0,0" VerticalAlignment="Center"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
            </StackPanel>

            <StackPanel x:Name="PnlSequence" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock Text="名称模板:" VerticalAlignment="Center" ToolTip="{}{n}=序号，{name}=原名，扩展名自动保留"/>
                <TextBox x:Name="TxtTemplate" Width="150" Margin="6,0,0,0" Text="{}{name}_{n}" TextChanged="Setting_Changed"/>
                <TextBlock Text="起始序号:" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtStart" Width="50" Text="1" TextChanged="Setting_Changed"/>
            </StackPanel>

            <StackPanel x:Name="PnlDate" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock Text="日期格式:" VerticalAlignment="Center" ToolTip="取文件最后修改时间，如 yyyyMMdd"/>
                <TextBox x:Name="TxtDateFormat" Width="120" Margin="6,0,0,0" Text="yyyyMMdd" TextChanged="Setting_Changed"/>
                <CheckBox x:Name="CbDateAfter" Content="加在名称后" Margin="12,0,0,0" VerticalAlignment="Center"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="PreviewGrid" Grid.Row="3" Margin="0,10,0,0" Height="180"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding OldName}" Header="原文件名" Width="*"/>
                <DataGridTextColumn Binding="{Binding NewName}" Header="新文件名" Width="*"/>
                <DataGridTextColumn Binding="{Binding Status}" Header="状态" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <Button x:Name="BtnExecute" DockPanel.Dock="Left" Content="执行重命名" Width="110" Click="BtnExecuteRename_Click"/>
            <TextBlock x:Name="TxtStatus" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" Text="添加文件后自动生成预览。"/>
        </DockPanel>
    </Grid>
</UserControl>
